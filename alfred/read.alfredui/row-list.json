{
 "type": "dataview",
 "id": "readList",
 "constraints": {
  "stretch": "horizontal",
  "size": {
   "height": 50
  }
 },
 "placeholder": "",
 "behaviour": {
  "selection": {
   "wrap": "vertical"
  }
 },
 "cell": {
  "height": 66,
  "init": {
   "rRow.background": null,
   "rTitle.colour": "labelColor",
   "rSub.colour": "secondaryLabelColor",
   "rHead.colour": "secondaryLabelColor",
   "rIcon.contenttintcolour": "secondaryLabelColor"
  },
  "selected": {
   "rRow.background": "quaternaryLabelColor"
  },
  "root": {
   "type": "view",
   "id": "rRow",
   "layout": "border",
   "padding": 12,
   "spacing": 14,
   "cornerradius": 12,
   "components": [
    {
     "type": "imageview",
     "id": "rIcon",
     "constraints": {
      "region": "left",
      "position": "centre",
      "size": {
       "width": 26,
       "height": 26
      }
     }
    },
    {
     "type": "view",
     "layout": "inline",
     "direction": "vertical",
     "spacing": 3,
     "constraints": {
      "region": "centre",
      "size": {
       "height": 46
      }
     },
     "components": [
      {
       "type": "label",
       "id": "rTitle",
       "font": {
        "size": 18
       },
       "linebreak": "truncatetail",
       "constraints": {
        "position": "left",
        "size": {
         "height": 24
        }
       }
      },
      {
       "type": "label",
       "id": "rSub",
       "font": {
        "size": 14
       },
       "linebreak": "truncatetail",
       "constraints": {
        "position": "left",
        "size": {
         "height": 19
        }
       }
      }
     ]
    },
    {
     "type": "label",
     "id": "rHead",
     "font": {
      "size": 14,
      "weight": "semibold"
     },
     "constraints": {
      "region": "right",
      "position": "centre"
     }
    },
    {
     "type": "label",
     "id": "rUuid",
     "hidden": true
    }
   ]
  }
 },
 "data": {
  "type": "basic",
  "src": []
 },
 "focus": true
}