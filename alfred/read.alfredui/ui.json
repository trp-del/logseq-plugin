{
 "bundleid": "com.openai.alfred.logseq-db.read",
 "log": {
  "level": "info",
  "internal": true,
  "path": "logseq-read.log",
  "timestamp": true
 },
 "variablesconfig": {
  "query": {
   "src": "args[0]"
  },
  "LOGSEQ_TOKEN": {
   "src": "variable",
   "scriptenv": true
  },
  "LOGSEQ_HOST": {
   "src": "variable",
   "scriptenv": true
  },
  "LOGSEQ_PORT": {
   "src": "variable",
   "scriptenv": true
  },
  "r_path": {
   "default": ""
  },
  "r_uuid": {
   "default": ""
  },
  "r_page": {
   "default": ""
  }
 },
 "window": {
  "padding": 26,
  "root": {
   "type": "view",
   "layout": "inline",
   "direction": "vertical",
   "spacing": 16,
   "events": [
    {
     "triggers": "launched",
     "action": {
      "type": "script",
      "src": "read",
      "args": [
       "{var:query}",
       ""
      ]
     }
    }
   ],
   "shortcuts": [
    {
     "shortcut": "↑",
     "action": {
      "type": "function",
      "src": "readList",
      "args": "selectup"
     }
    },
    {
     "shortcut": "↓",
     "action": {
      "type": "function",
      "src": "readList",
      "args": "selectdown"
     }
    },
    {
     "shortcut": "↩",
     "action": {
      "type": "script",
      "src": "read",
      "args": [
       "{value:readList.selected.rUuid.text}",
       "{var:r_path}"
      ]
     }
    },
    {
     "shortcut": "⌘[",
     "action": {
      "type": "script",
      "src": "back",
      "args": [
       "{var:r_path}"
      ]
     }
    },
    {
     "shortcut": "⌘↩",
     "action": {
      "type": "json",
      "src": {
       "finish": {
        "args": "open:{var:r_uuid}"
       }
      }
     }
    }
   ],
   "components": [
    {
     "type": "label",
     "id": "pTrail",
     "text": "Logseq",
     "colour": "secondaryLabelColor",
     "font": {
      "size": 14
     },
     "constraints": {
      "position": "left"
     }
    },
    {
     "type": "view",
     "layout": "inline",
     "spacing": 10,
     "constraints": {
      "position": "left"
     },
     "components": [
      {
       "type": "label",
       "id": "pTitle",
       "text": "Reading…",
       "font": {
        "size": 28,
        "weight": "semibold"
       },
       "linebreak": "truncatetail",
       "constraints": {
        "position": "left"
       }
      },
      {
       "type": "label",
       "id": "pTags",
       "text": "",
       "colour": "secondaryLabelColor",
       "font": {
        "size": 18
       },
       "constraints": {
        "position": "centre"
       }
      }
     ]
    },
    {
     "type": "markdownarea",
     "id": "pText",
     "text": "",
     "hidden": true,
     "urischemes": [
      "http",
      "https",
      "logseq"
     ],
     "font": {
      "size": 16
     },
     "constraints": {
      "stretch": "horizontal",
      "size": {
       "height": 40
      }
     },
     "background": "#00000000",
     "colour": "labelColor"
    },
    "{file:row-list.json}",
    {
     "type": "label",
     "id": "pFoot",
     "text": "",
     "colour": "secondaryLabelColor",
     "font": {
      "size": 14
     },
     "constraints": {
      "position": "right"
     }
    }
   ]
  },
  "size": {
   "width": 900
  }
 }
}