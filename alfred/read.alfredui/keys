#!/bin/zsh
# The panel's pulse: is Option held? Alfred UI has no event for a held key, so the keyboard is asked a few times a second, and
# the foot's guide is shown or hidden only when the answer changed.   keys <shown now: 1 or empty> <id> <id>
# A small program answers in a few thousandths of a second; it is built once, on first use (Apple's Swift compiler, as for the
# toast). Until it is there, and where it cannot be built, AppleScript's JavaScript answers, more slowly.
here="${0:A:h:h}"
bin="${alfred_workflow_cache:-${TMPDIR:-/tmp}/logseq-alfred}/optionheld"
if [[ -x "$bin" ]]; then held=$("$bin" 2>/dev/null)
else
  mkdir -p "${bin:h}" 2>/dev/null
  if mkdir "$bin.building" 2>/dev/null; then ( /usr/bin/swiftc -O "$here/optionheld.swift" -o "$bin" >/dev/null 2>&1; rmdir "$bin.building" ) &! fi
  held=$(/usr/bin/osascript -l JavaScript -e 'ObjC.import("AppKit"); ($.NSEvent.modifierFlags & 524288) ? "1" : "0"' 2>/dev/null)
fi
[[ "$held" == "1" ]] || held=""
if [[ "$held" == "$1" ]]; then print -r -- '{}'; exit 0; fi
if [[ -n "$held" ]]; then hidden=false; else hidden=true; fi
print -r -- "{\"variables\":{\"k_shown\":\"$held\"},\"update\":{\"ids\":{\"$2\":{\"hidden\":$hidden},\"$3\":{\"hidden\":$hidden}}}}"
