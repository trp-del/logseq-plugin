{
 "bundleid": "com.openai.alfred.logseq-db.search",
 "log": {
  "level": "info",
  "internal": true,
  "path": "logseq-search.log",
  "timestamp": true
 },
 "variablesconfig": {
  "query": {
   "src": "args[0]"
  },
  "LOGSEQ_TOKEN": {
   "src": "variable",
   "scriptenv": true
  },
  "LOGSEQ_HOST": {
   "src": "variable",
   "scriptenv": true
  },
  "LOGSEQ_PORT": {
   "src": "variable",
   "scriptenv": true
  }
 },
 "window": {
  "padding": 26,
  "root": {
   "type": "view",
   "layout": "inline",
   "direction": "vertical",
   "spacing": 16,
   "events": [
    {
     "triggers": "launched",
     "action": {
      "type": "script",
      "src": "find",
      "args": [
       "{value:sq.text}"
      ]
     }
    }
   ],
   "shortcuts": [
    {
     "shortcut": "↑",
     "action": {
      "type": "function",
      "src": "searchList",
      "args": "selectup"
     }
    },
    {
     "shortcut": "↓",
     "action": {
      "type": "function",
      "src": "searchList",
      "args": "selectdown"
     }
    },
    {
     "shortcut": "⌘↩",
     "action": {
      "type": "json",
      "src": {
       "finish": {
        "args": "open:{value:searchList.selected.rUuid.text}"
       }
      }
     }
    }
   ],
   "components": [
    {
     "type": "textfield",
     "id": "sq",
     "focus": true,
     "text": "{var:query}",
     "placeholder": "Search the words of your notes",
     "bordered": false,
     "focusring": false,
     "background": "#00000000",
     "font": {
      "size": 28,
      "weight": "light"
     },
     "constraints": {
      "stretch": "horizontal"
     },
     "events": [
      {
       "triggers": "typingstopped",
       "action": {
        "type": "script",
        "src": "find",
        "async": true,
        "args": [
         "{value:sq.text}"
        ]
       }
      },
      {
       "triggers": "actioned",
       "action": {
        "type": "json",
        "src": {
         "finish": {
          "args": "read:{value:searchList.selected.rUuid.text}"
         }
        }
       }
      }
     ]
    },
    {
     "type": "view",
     "id": "sLine1",
     "background": "separatorColor",
     "constraints": {
      "stretch": "horizontal",
      "size": {
       "height": 1
      }
     }
    },
    {
     "type": "view",
     "id": "sBody",
     "layout": "border",
     "spacing": 0,
     "constraints": {
      "stretch": "horizontal"
     },
     "components": [
      "{file:row-list.json}",
      {
       "type": "view",
       "id": "sPane",
       "hidden": true,
       "constraints": {
        "region": "right",
        "size": {
         "width": 1
        }
       },
       "components": []
      }
     ]
    },
    {
     "type": "view",
     "id": "sLine2",
     "background": "separatorColor",
     "constraints": {
      "stretch": "horizontal",
      "size": {
       "height": 1
      }
     }
    },
    {
     "type": "view",
     "layout": "border",
     "constraints": {
      "stretch": "horizontal"
     },
     "components": [
      {
       "type": "label",
       "id": "sNote",
       "text": "",
       "colour": "secondaryLabelColor",
       "font": {
        "size": 14
       },
       "constraints": {
        "region": "left",
        "position": "centre"
       }
      },
      {
       "type": "label",
       "id": "sKeys",
       "text": "Read ↩      Open in Logseq ⌘↩",
       "colour": "secondaryLabelColor",
       "font": {
        "size": 14
       },
       "constraints": {
        "region": "right",
        "position": "centre"
       }
      }
     ]
    }
   ]
  },
  "size": {
   "width": 900
  }
 }
}