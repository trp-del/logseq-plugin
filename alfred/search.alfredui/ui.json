{
 "bundleid": "com.openai.alfred.logseq-db.search",
 "log": {
  "level": "info",
  "internal": true,
  "path": "logseq-search.log",
  "timestamp": true
 },
 "variablesconfig": {
  "LOGSEQ_TOKEN": {
   "src": "variable",
   "scriptenv": true
  },
  "LOGSEQ_HOST": {
   "src": "variable",
   "scriptenv": true
  },
  "LOGSEQ_PORT": {
   "src": "variable",
   "scriptenv": true
  },
  "query": {
   "src": "args[0]"
  },
  "k_shown": {
   "default": "",
   "scriptenv": true
  }
 },
 "pulse": {
  "src": "keys",
  "args": [
   "{var:k_shown}",
   "sGo",
   "sKeys"
  ],
  "interval": 0.12,
  "intervalmode": "delay"
 },
 "window": {
  "padding": 26,
  "size": {
   "width": 900
  },
  "root": {
   "type": "view",
   "layout": "inline",
   "direction": "vertical",
   "spacing": 14,
   "events": [
    {
     "triggers": "launched",
     "action": {
      "type": "script",
      "src": "find",
      "args": [
       "{value:sq.text}"
      ]
     }
    }
   ],
   "shortcuts": [
    {
     "shortcut": "↑",
     "action": {
      "type": "function",
      "src": "searchList",
      "args": "selectup"
     }
    },
    {
     "shortcut": "↓",
     "action": {
      "type": "function",
      "src": "searchList",
      "args": "selectdown"
     }
    },
    {
     "shortcut": "⌘↩",
     "action": {
      "type": "json",
      "src": {
       "finish": {
        "args": "open:{value:searchList.selected.rUuid.text}"
       }
      }
     }
    },
    {
     "shortcut": "⌘C",
     "action": {
      "type": "script",
      "src": "copy",
      "args": [
       "{value:searchList.selected.rUuid.text}"
      ],
      "async": true
     }
    }
   ],
   "components": [
    {
     "type": "textfield",
     "id": "sq",
     "focus": true,
     "text": "{var:query}",
     "placeholder": "Search the words of your notes",
     "bordered": false,
     "focusring": false,
     "background": "#00000000",
     "font": {
      "size": 28,
      "weight": "light"
     },
     "constraints": {
      "stretch": "horizontal"
     },
     "events": [
      {
       "triggers": "typingstopped",
       "action": {
        "type": "script",
        "src": "find",
        "args": [
         "{value:sq.text}"
        ],
        "async": true
       }
      },
      {
       "triggers": "actioned",
       "action": {
        "type": "json",
        "src": {
         "finish": {
          "args": "read:{value:searchList.selected.rUuid.text} {value:sq.text}"
         }
        }
       }
      }
     ]
    },
    {
     "type": "view",
     "id": "sLine1",
     "background": "separatorColor",
     "constraints": {
      "stretch": "horizontal",
      "size": {
       "height": 1
      }
     }
    },
    {
     "type": "view",
     "id": "sBody",
     "layout": "border",
     "spacing": 0,
     "constraints": {
      "stretch": "horizontal"
     },
     "components": [
      "{file:row-list.json}",
      {
       "type": "view",
       "id": "sPane",
       "hidden": true,
       "constraints": {
        "region": "right",
        "size": {
         "width": 1
        }
       },
       "components": []
      }
     ]
    },
    {
     "type": "view",
     "id": "sLine2",
     "background": "separatorColor",
     "constraints": {
      "stretch": "horizontal",
      "size": {
       "height": 1
      }
     }
    },
    {
     "type": "view",
     "id": "sFoot",
     "layout": "border",
     "spacing": 14,
     "constraints": {
      "stretch": "horizontal",
      "size": {
       "height": 34
      }
     },
     "components": [
      {
       "type": "label",
       "id": "sNote",
       "text": "",
       "colour": "secondaryLabelColor",
       "font": {
        "size": 14
       },
       "constraints": {
        "region": "left",
        "position": "centre"
       }
      },
      {
       "type": "label",
       "id": "sKeys",
       "text": "Open in Logseq ⌘↩",
       "hidden": true,
       "colour": "secondaryLabelColor",
       "font": {
        "size": 14
       },
       "textalign": "right",
       "constraints": {
        "region": "centre",
        "position": "right"
       }
      },
      {
       "type": "button",
       "id": "sGo",
       "text": "Open here  ↩",
       "hidden": true,
       "constraints": {
        "region": "right",
        "position": "centre"
       },
       "events": [
        {
         "triggers": "actioned",
         "action": {
          "type": "json",
          "src": {
           "finish": {
            "args": "read:{value:searchList.selected.rUuid.text} {value:sq.text}"
           }
          }
         }
        }
       ],
       "bordered": true,
       "bordershape": "capsule",
       "effect": "glass"
      }
     ]
    }
   ]
  }
 }
}