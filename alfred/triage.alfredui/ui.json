{
 "bundleid": "com.openai.alfred.logseq-db.triage",
 "log": {
  "level": "info",
  "internal": true,
  "path": "logseq-triage.log",
  "timestamp": true
 },
 "variablesconfig": {
  "LOGSEQ_TOKEN": {
   "src": "variable",
   "scriptenv": true
  },
  "LOGSEQ_HOST": {
   "src": "variable",
   "scriptenv": true
  },
  "LOGSEQ_PORT": {
   "src": "variable",
   "scriptenv": true
  },
  "t_uuid": {
   "default": ""
  },
  "t_passed": {
   "default": ""
  },
  "t_tagged": {
   "default": ""
  },
  "t_summary": {
   "default": ""
  }
 },
 "window": {
  "padding": 26,
  "root": {
   "type": "view",
   "layout": "stack",
   "events": [
    {
     "triggers": "launched",
     "action": {
      "type": "script",
      "src": "next",
      "args": [
       "",
       "",
       ""
      ]
     }
    }
   ],
   "shortcuts": [
    {
     "shortcut": "⇥",
     "action": {
      "type": "script",
      "src": "next",
      "args": [
       "{var:t_passed},{var:t_uuid}",
       "{var:t_tagged}",
       "{var:t_summary}"
      ]
     }
    },
    {
     "shortcut": "⌘⌫",
     "action": {
      "type": "script",
      "src": "tag",
      "args": [
       "{var:t_uuid}",
       "",
       "{var:t_passed}",
       "{var:t_tagged}",
       "{var:t_summary}"
      ]
     }
    },
    {
     "shortcut": "⌘t",
     "action": {
      "type": "script",
      "src": "tags"
     }
    }
   ],
   "components": [
    {
     "type": "view",
     "id": "tbody",
     "layout": "inline",
     "direction": "vertical",
     "spacing": 16,
     "components": [
      {
       "type": "label",
       "id": "tCount",
       "text": "Tag what came in",
       "colour": "secondaryLabelColor",
       "font": {
        "size": 14
       },
       "constraints": {
        "position": "left"
       }
      },
      {
       "type": "label",
       "id": "tWords",
       "text": "Looking for notes added from Alfred with no tag…",
       "font": {
        "size": 28,
        "weight": "light"
       },
       "linebreak": "wordwrap",
       "constraints": {
        "position": "left",
        "size": {
         "width": 848
        }
       }
      },
      {
       "type": "view",
       "id": "tChoices",
       "layout": "inline",
       "direction": "vertical",
       "spacing": 8,
       "components": [],
       "constraints": {
        "position": "left"
       }
      },
      {
       "type": "label",
       "text": "Pass by ⇥      Leave untagged ⌘⌫      All tags ⌘T",
       "colour": "secondaryLabelColor",
       "font": {
        "size": 14
       },
       "constraints": {
        "position": "right"
       }
      }
     ]
    }
   ]
  },
  "size": {
   "width": 900
  }
 }
}