{
 "bundleid": "com.openai.alfred.logseq-db.home",
 "log": {
  "level": "info",
  "internal": true,
  "path": "logseq-home.log",
  "timestamp": true
 },
 "variablesconfig": {
  "query": {
   "src": "args[0]"
  },
  "LOGSEQ_TOKEN": {
   "src": "variable",
   "scriptenv": true
  },
  "LOGSEQ_HOST": {
   "src": "variable",
   "scriptenv": true
  },
  "LOGSEQ_PORT": {
   "src": "variable",
   "scriptenv": true
  },
  "h_order": {
   "default": ""
  },
  "h_lit": {
   "default": ""
  },
  "h_state": {
   "default": ""
  },
  "h_tab": {
   "default": ""
  },
  "h_tabLabel": {
   "default": ""
  },
  "h_last": {
   "default": ""
  }
 },
 "window": {
  "padding": 20,
  "root": {
   "type": "view",
   "layout": "inline",
   "direction": "vertical",
   "spacing": 12,
   "events": [
    {
     "triggers": "launched",
     "action": {
      "type": "script",
      "src": "find",
      "args": [
       "{value:hq.text}",
       ""
      ]
     }
    }
   ],
   "shortcuts": [
    {
     "shortcut": "↑",
     "action": {
      "type": "function",
      "src": "homeList",
      "args": "selectup"
     }
    },
    {
     "shortcut": "↓",
     "action": {
      "type": "function",
      "src": "homeList",
      "args": "selectdown"
     }
    },
    {
     "shortcut": "⇥",
     "action": {
      "type": "script",
      "src": "tab",
      "args": [
       "{value:hq.text}",
       "{var:h_state}",
       "{var:h_tab}"
      ]
     }
    },
    {
     "shortcut": "⌘⌫",
     "action": {
      "type": "script",
      "src": "untake",
      "args": [
       "{value:hq.text}",
       "{var:h_state}"
      ]
     }
    },
    {
     "shortcut": "⌘↩",
     "action": {
      "type": "json",
      "src": {
       "finish": {
        "args": "open:{value:homeList.selected.hGo.text}"
       }
      }
     }
    },
    {
     "shortcut": "⌘d",
     "action": {
      "type": "script",
      "src": "status",
      "args": [
       "{value:homeList.selected.hGo.text}",
       "done",
       "{value:hq.text}",
       "{var:h_state}"
      ]
     }
    },
    {
     "shortcut": "⌘g",
     "action": {
      "type": "script",
      "src": "status",
      "args": [
       "{value:homeList.selected.hGo.text}",
       "doing",
       "{value:hq.text}",
       "{var:h_state}"
      ]
     }
    },
    {
     "shortcut": "⌘z",
     "action": {
      "type": "script",
      "src": "undo",
      "args": [
       "{var:h_last}",
       "{value:hq.text}",
       "{var:h_state}"
      ]
     }
    }
   ],
   "components": [
    {
     "type": "view",
     "layout": "border",
     "spacing": 10,
     "constraints": {
      "stretch": "horizontal"
     },
     "components": [
      {
       "type": "view",
       "id": "hPicks",
       "layout": "inline",
       "hidden": true,
       "constraints": {
        "region": "left",
        "position": "centre"
       },
       "components": []
      },
      {
       "type": "textfield",
       "id": "hq",
       "focus": true,
       "text": "{var:query}",
       "placeholder": "Find, or write a note",
       "bordered": false,
       "focusring": false,
       "background": "#00000000",
       "font": {
        "size": 28,
        "weight": "light"
       },
       "constraints": {
        "region": "centre"
       },
       "events": [
        {
         "triggers": "typingstopped",
         "action": {
          "type": "script",
          "src": "find",
          "async": true,
          "args": [
           "{value:hq.text}",
           "{var:h_state}"
          ]
         }
        },
        {
         "triggers": "actioned",
         "action": {
          "type": "json",
          "src": {
           "finish": {
            "args": "{value:homeList.selected.hGo.text}"
           }
          }
         }
        }
       ]
      }
     ]
    },
    {
     "type": "view",
     "id": "hLine1",
     "hidden": false,
     "background": "separatorColor",
     "constraints": {
      "stretch": "horizontal",
      "size": {
       "height": 1
      }
     }
    },
    {
     "type": "view",
     "id": "hLines",
     "layout": "inline",
     "direction": "vertical",
     "spacing": 10,
     "hidden": true,
     "constraints": {
      "stretch": "horizontal"
     },
     "components": []
    },
    {
     "type": "view",
     "id": "hLine2",
     "hidden": true,
     "background": "separatorColor",
     "constraints": {
      "stretch": "horizontal",
      "size": {
       "height": 1
      }
     }
    },
    {
     "type": "view",
     "id": "hBody",
     "layout": "border",
     "spacing": 0,
     "constraints": {
      "stretch": "horizontal"
     },
     "components": [
      {
       "type": "view",
       "id": "homeList",
       "constraints": {
        "region": "centre",
        "size": {
         "height": 60
        }
       },
       "components": []
      },
      {
       "type": "view",
       "id": "hPane",
       "hidden": true,
       "constraints": {
        "region": "right",
        "size": {
         "width": 1
        }
       },
       "components": []
      }
     ]
    },
    {
     "type": "view",
     "id": "hLine3",
     "hidden": false,
     "background": "separatorColor",
     "constraints": {
      "stretch": "horizontal",
      "size": {
       "height": 1
      }
     }
    },
    {
     "type": "view",
     "layout": "border",
     "constraints": {
      "stretch": "horizontal"
     },
     "components": [
      {
       "type": "label",
       "id": "hCount",
       "text": "",
       "colour": "secondaryLabelColor",
       "font": {
        "size": 14
       },
       "constraints": {
        "region": "left",
        "position": "centre"
       }
      },
      {
       "type": "label",
       "id": "hFoot",
       "text": "",
       "colour": "secondaryLabelColor",
       "font": {
        "size": 14
       },
       "textalign": "right",
       "constraints": {
        "region": "centre",
        "position": "right"
       }
      }
     ]
    }
   ]
  },
  "size": {
   "width": 900
  }
 }
}