{
 "bundleid": "com.openai.alfred.logseq-db.selection",
 "log": {
  "level": "info",
  "internal": true,
  "path": "logseq-selection.log",
  "timestamp": true
 },
 "variablesconfig": {
  "query": {
   "src": "args[0]"
  },
  "LOGSEQ_TOKEN": {
   "src": "variable",
   "scriptenv": true
  },
  "LOGSEQ_HOST": {
   "src": "variable",
   "scriptenv": true
  },
  "LOGSEQ_PORT": {
   "src": "variable",
   "scriptenv": true
  },
  "picked_tag": {
   "default": ""
  },
  "guessed_tag": {
   "default": ""
  },
  "last_uuid": {
   "default": ""
  },
  "s_title": {
   "default": ""
  }
 },
 "window": {
  "padding": 26,
  "root": {
   "type": "view",
   "layout": "stack",
   "events": [
    {
     "triggers": "launched",
     "action": {
      "type": "script",
      "src": "start",
      "args": [
       "{var:query}"
      ]
     }
    }
   ],
   "components": [
    {
     "type": "view",
     "id": "body",
     "layout": "inline",
     "direction": "vertical",
     "spacing": 16,
     "components": [
      {
       "type": "label",
       "id": "sSource",
       "text": "Reading the selection…",
       "colour": "secondaryLabelColor",
       "font": {
        "size": 14
       },
       "constraints": {
        "position": "left"
       }
      },
      {
       "type": "view",
       "layout": "inline",
       "direction": "vertical",
       "spacing": 10,
       "padding": 18,
       "cornerradius": 16,
       "background": {
        "light": "#0000000a",
        "dark": "#ffffff12"
       },
       "constraints": {
        "stretch": "horizontal"
       },
       "components": [
        {
         "type": "label",
         "id": "sText",
         "text": "",
         "linebreak": "wordwrap",
         "font": {
          "size": 18
         },
         "constraints": {
          "position": "left",
          "size": {
           "width": 812
          }
         }
        },
        {
         "type": "view",
         "layout": "inline",
         "spacing": 8,
         "constraints": {
          "position": "left"
         },
         "components": [
          {
           "type": "label",
           "text": "Tag",
           "colour": "secondaryLabelColor",
           "font": {
            "size": 14
           }
          },
          {
           "type": "label",
           "id": "tagName",
           "text": "",
           "colour": "tertiaryLabelColor",
           "font": {
            "size": 15
           }
          },
          {
           "type": "label",
           "id": "tagWhy",
           "text": "",
           "colour": "secondaryLabelColor",
           "font": {
            "size": 14
           }
          }
         ]
        },
        {
         "type": "view",
         "id": "choices",
         "layout": "inline",
         "spacing": 14,
         "hidden": true,
         "components": [],
         "constraints": {
          "position": "left"
         }
        },
        {
         "type": "view",
         "id": "props",
         "layout": "form",
         "spacing": 9,
         "hidden": true,
         "components": [],
         "constraints": {
          "position": "left"
         }
        }
       ]
      },
      {
       "type": "textfield",
       "id": "own",
       "focus": true,
       "placeholder": "A note of your own under it (optional)",
       "bordered": false,
       "focusring": false,
       "background": "#00000000",
       "font": {
        "size": 18
       },
       "constraints": {
        "stretch": "horizontal"
       }
      },
      {
       "type": "view",
       "layout": "border",
       "constraints": {
        "stretch": "horizontal"
       },
       "components": [
        {
         "type": "picker",
         "id": "where",
         "bordered": false,
         "selected": "today",
         "constraints": {
          "region": "left"
         },
         "items": [
          {
           "text": "Today",
           "value": "today"
          },
          {
           "text": "The page open in Logseq",
           "value": "open"
          },
          {
           "text": "A page named after the source",
           "value": "page"
          }
         ]
        },
        {
         "type": "button",
         "id": "sGo",
         "text": "Add  ↩",
         "shortcut": "↩",
         "bordered": true,
         "bordershape": "capsule",
         "effect": "glass",
         "constraints": {
          "region": "right",
          "position": "right"
         },
         "events": [
          {
           "triggers": "actioned",
           "action": {
            "type": "script",
            "src": "add",
            "args": [
             "{var:query}",
             "{value:where.selected.value}",
             "{var:picked_tag}{var:guessed_tag}",
             "{value:own.text}"
            ]
           }
          }
         ]
        }
       ]
      }
     ]
    }
   ]
  },
  "size": {
   "width": 900
  }
 }
}